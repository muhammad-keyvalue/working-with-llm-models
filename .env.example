# Copy to .env and fill in ONE of the options below.

# --- Option A: LiteLLM proxy (key from your LiteLLM gateway) -----------------
# MODEL is "litellm_proxy/" + a model name configured on the proxy.
# List available names: curl $LITELLM_PROXY_API_BASE/v1/models -H "Authorization: Bearer $LITELLM_PROXY_API_KEY"
MODEL=litellm_proxy/gpt-4o-mini
LITELLM_PROXY_API_BASE=https://your-litellm-proxy.example.com
LITELLM_PROXY_API_KEY=sk-...

# --- Option B: call a provider directly ---------------------------------------
# Comment out Option A, then uncomment one MODEL and its key.
# MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# MODEL=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=...

# MODEL=ollama/llama3.1          # local, no key needed

# --- Multimodal programs (9-11), optional -------------------------------------
# VISION_MODEL defaults to MODEL. AUDIO_MODEL / TTS_MODEL default to whisper-1 / tts-1,
# with the litellm_proxy/ prefix added when MODEL uses the proxy.
# VISION_MODEL=litellm_proxy/openai/gpt-4.1-mini
# AUDIO_MODEL=litellm_proxy/whisper-1
# TTS_MODEL=litellm_proxy/tts-1
